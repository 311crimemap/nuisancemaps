# .env.stub
#
# Prod
# most configuration is moved to configmaps
# only store secrets directly here
#
# TODO: move out spring config

#
# Hetzner
#

HCLOUD_TOKEN=

# Containers

IMAGE_REPO=                    # ECR host

#
# Database
#

POSTGRESQL_PASSWORD=
POSTGRESQL_POSTGRES_PASSWORD=
REPMGR_PASSWORD=
PGPOOL_PASSWORD=

# pgbackrest  - avoid setting PGPASSWORD
# will override any other container based database passwords
PGBACKREST_REPO2_S3_KEY_SECRET=
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_REGION=
PGBACKREST_REPO2_S3_ENDPOINT=
PGBACKREST_REPO2_S3_BUCKET=

# values used for aws operations (s3, ecr)
AWS_SYNC_REGION=
AWS_SYNC_PROFILE=
AWS_SYNC_BUCKET=   # NB: not used in prod

#
# API
#

CORS_ORIGINS=https://311crimemap.com,https://www.311crimemap.com
WORKER_QUERY_LIMIT=50000        # data worker num records per request
BATCH_SIZE=25000                # batch size for DataParser
ADMIN_API_KEY=                  # Admin API Key
VITE_MAX_DATA_RECORDS=20000     # data* controllers return num max records; shared with web

# Data Dir
FETCH_DATA_DIR=/data
DATA_DIR_MIN_FREE=5000000000 #5gb

#
# Threads
# in worker configMap
# ASYNC_EXECUTOR_CORE_POOL_SIZE=4
# ASYNC_EXECUTOR_MAX_POOL_SIZE=4
# ASYNC_EXECUTOR_QUEUE_CAPACITY=8

#
# Support
#

OPENAI_API_KEY=

#
# Worker
#
MAPTILER_HOST_REFERER="api.311crimemap.com"

#
# Maps and Geocoding
# make sure keys are domain restricted
#
VITE_PROTOMAPS_API_KEY=
VITE_MAPTILER_API_KEY=
GEOAPIFY_API_KEY=

#
# Web
#
VITE_API_SERVER_URL=https://api.311crimemap.com

#
# Grafana
#
GRAFANA_PASSWORD=
