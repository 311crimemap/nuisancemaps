#
# Database
#

# Env (dev / prod)
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=
POSTGRESQL_POSTGRESQL_PASSWORD=
POSTGRESQL_DATABASE=
POSTGRESQL_URL=jdbc:postgresql://<db_host/service>:<db_port:5432>/<db_name>

# pgbackrest
PGPASSWORD=                     # pgbackrest connect local socket
PGBACKREST_REPO2_S3_KEY_SECRET= # bucket creds
PGBACKREST_REPO2_S3_KEY=        # bucket creds

# comma separated allowable CORS urls (5173 dev, 4173 build build)
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ORIGINS=
WORKER_QUERY_LIMIT= # data worker num records per request
BATCH_SIZE=         # batch size for DataParser
ADMIN_API_KEY=      # Admin API Key
VITE_MAX_DATA_RECORDS=   # data* controllers return num max records; shared with web

# Data Dir
FETCH_DATA_DIR=     # worker file save directory
DATA_DIR_MIN_FREE=  # gb free space (usable)

# pgpool
PGPOOL_USER_CONF_FILE=/config/custom_pgpool.conf
PGPOOL_BACKEND_NODES=0:pg-0:5432,1:pg-1:5432
PGPOOL_SR_CHECK_USER=repmgr
PGPOOL_SR_CHECK_PASSWORD=
PGPOOL_ENABLE_LDAP=no
PGPOOL_POSTGRES_USERNAME=postgres
PGPOOL_POSTGRES_PASSWORD=
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=
PGPOOL_ENABLE_LOAD_BALANCING=yes

# reprmgr
REPMGR_PRIMARY_HOST=pg-0
REPMGR_PARTNER_NODES=pg-0,pg-1
REPMGR_USERNAME=repmgr
REPMGR_PASSWORD=


# Test
POSTGRESQL_TEST_USER=
POSTGRESQL_TEST_PASSWORD=
POSTGRESQL_TEST_DATABASE=
POSTGRESQL_TEST_URL=

#
# Threads
#
ASYNC_EXECUTOR_CORE_POOL_SIZE=4
ASYNC_EXECUTOR_MAX_POOL_SIZE=4
ASYNC_EXECUTOR_QUEUE_CAPACITY=8

#
# Support
#
OPENAI_API_KEY=

#
# Worker
#
MAPTILER_HOST_REFERER= # referer hostname/wildcard for api key

#
# Maps and Geocoding
# make sure keys are domain restricted
#
VITE_PROTOMAPS_API_KEY=
VITE_MAPTILER_API_KEY=
GEOAPIFY_API_KEY=

#
# Web
#
VITE_API_SERVER_URL=http://localhost:8080


#
# GRAFANA
# default password via helm prometheus-community/kube-prometheus-stack: grafana.adminPassword
GRAFANA_PASSWORD=prom-operator